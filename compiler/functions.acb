# functions.acb — demonstrates function definitions and recursion

def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

let result = factorial(5)
print "factorial(5) ="
print result

print "fib(10) ="
print fib(10)
